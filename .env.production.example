# ==============================================================================
# WishesAndDOOs — Production Environment Configuration (.env.production)
# ==============================================================================

# Database Settings (PostgreSQL 15+)
POSTGRES_USER=wad_user
POSTGRES_PASSWORD=replace_with_a_secure_random_64_character_hex_or_alphanumeric_password
POSTGRES_DB=wishes_and_doos

# Application Secrets (MANDATORY: Generate with `python -c "import secrets; print(secrets.token_hex(32))"`)
SECRET_KEY=replace_with_32_byte_random_secret_key_for_flask_session_signing
JWT_SECRET_KEY=replace_with_32_byte_random_secret_key_for_jwt_token_encryption

# Allowed CORS Origins (Comma-separated list of allowed domains)
CORS_ORIGINS=https://wishesanddoos.app,https://www.wishesanddoos.app

# Client API Base URL
# If hosting client and API behind Nginx on the same domain: /api/v1
# If hosting separately (e.g. Vercel + Railway): https://api.wishesanddoos.app/api/v1
EXPO_PUBLIC_API_URL=/api/v1

# Port Bindings
WEB_PORT=80
API_PORT=5000

# Concurrency & Scaling
WEB_CONCURRENCY=3
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Optional Demo Data (Set to true only for staging/demo environments, false for real production)
SEED_DEMO_DATA=false
