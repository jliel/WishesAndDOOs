# Flask API Environment Variables (.env)
FLASK_ENV=development
FLASK_DEBUG=true

# Database Connection (defaults to local SQLite if omitted)
# DATABASE_URL=postgresql://wad_user:wad_dev_password@localhost:5432/wishes_and_doos

# Security Keys
SECRET_KEY=dev-secret-key-change-in-production-32b
JWT_SECRET_KEY=dev-jwt-secret-key-change-in-prod-32b

# CORS & Rate Limiting
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
RATELIMIT_DEFAULT=120 per minute
RATELIMIT_STORAGE_URI=memory://

# Migrations & Seeding
FLASK_AUTO_CREATE_DB=true
FLASK_SEED_DEMO_DATA=true
